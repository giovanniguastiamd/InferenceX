--- a/python/sglang/srt/layers/hyperconnection.py
+++ b/python/sglang/srt/layers/hyperconnection.py
@@ -8,7 +8,11 @@ import torch.nn.functional as F
 
 from sglang.kernels.ops.gemm.hc_mix import fused_hc_mix, fused_hc_mix_supported
 from sglang.srt.environ import envs
-from sglang.srt.layers.hc_mix_flydsl import flydsl_hc_mix_supported, weight_cache_key
+from sglang.srt.layers.hc_mix_flydsl import (
+    flydsl_hc_mix_supported,
+    flydsl_hc_mix_weights_supported,
