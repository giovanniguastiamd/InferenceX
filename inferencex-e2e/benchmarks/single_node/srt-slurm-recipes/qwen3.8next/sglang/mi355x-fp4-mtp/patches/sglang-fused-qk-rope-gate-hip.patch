From c12137dee0a8c34a6599b528fb3004d6c30eafdb Mon Sep 17 00:00:00 2001
From: Chang Liu <cliu1004@amd.com>
Date: Thu, 15 Oct 2026 09:44:26 +0000
Subject: [PATCH 2/2] [AMD] Use the fused Triton QK-norm + RoPE + gate kernel
 on HIP for Qwen3.5/Qwen3.8

_prepare_qkv_gate sends HIP to forward_prepare_cuda_fused (one Triton kernel
for Gemma RMSNorm, NeoX/M-RoPE and the gate split) instead of the
norm-with-gate kernel plus a separate rotary_emb. The fused path accepts the
AITER fused all-reduce tuple input like the other prepare paths, and PDL stays
off on ROCm, where get_device_capability reports 9.x on gfx950.
---
 .../ops/attention/fused_qk_rmsnorm_rope_gate.py        |  2 +-
 python/sglang/srt/models/qwen3_5.py                    | 10 +++++++---
 2 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/python/sglang/kernels/ops/attention/fused_qk_rmsnorm_rope_gate.py b/python/sglang/kernels/ops/attention/fused_qk_rmsnorm_rope_gate.py
index 3648bd557c..9fa0777b4a 100644
--- a/python/sglang/kernels/ops/attention/fused_qk_rmsnorm_rope_gate.py
+++ b/python/sglang/kernels/ops/attention/fused_qk_rmsnorm_rope_gate.py
@@ -17,7 +17,7 @@ from triton.language.extra.cuda import libdevice
 
 def _pdl_supported() -> bool:
     """Check if Programmatic Dependent Launch is supported (NVIDIA SM >= 90)."""
-    if not torch.cuda.is_available():
+    if not torch.cuda.is_available() or torch.version.hip is not None:
         return False
     try:
         major, _ = torch.cuda.get_device_capability()
diff --git a/python/sglang/srt/models/qwen3_5.py b/python/sglang/srt/models/qwen3_5.py
index def6a402d5..9056608f3f 100644
--- a/python/sglang/srt/models/qwen3_5.py
+++ b/python/sglang/srt/models/qwen3_5.py
@@ -274,7 +274,7 @@ def _qwen3_5_stage_facts(
     )
 
 
-if _is_cuda:
+if _is_cuda or _is_hip:
     from sglang.kernels.ops.attention.fused_qk_rmsnorm_rope_gate import (
         fused_qk_gemma_rmsnorm_rope_gate,
     )
@@ -1427,6 +1427,10 @@ class Qwen3_5AttentionDecoderLayer(nn.Module):
 
     def forward_prepare_cuda_fused(self, positions, hidden_states):
         """Fused QK GemmaRMSNorm + NeoX RoPE + gate deinterleave."""
+        if _use_aiter and isinstance(hidden_states, tuple):
+            hidden_states = _select_fused_ar_input_for_linear(
+                hidden_states, self.qkv_proj
+            )
         qkv, _ = self.qkv_proj(hidden_states)
         if self.attn_output_gate:
             q_gate, k, v = qkv.split(
@@ -1535,12 +1539,12 @@ class Qwen3_5AttentionDecoderLayer(nn.Module):
         hidden_states: torch.Tensor,
         forward_batch: ForwardBatch,
     ) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor, Optional[torch.Tensor]]:
-        if _is_cuda and self.attn_output_gate:
+        if (_is_cuda or _is_hip) and self.attn_output_gate:
             return self.forward_prepare_cuda_fused(
                 positions=positions,
                 hidden_states=hidden_states,
             )
-        if (_is_hip or _is_xpu or _is_cpu) and self.attn_output_gate:
+        if (_is_xpu or _is_cpu) and self.attn_output_gate:
             return self.forward_prepare_fused_gate(
                 positions=positions,
                 hidden_states=hidden_states,
