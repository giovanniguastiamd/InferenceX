From e0512f9be9bd4025be2c55312d0093e7d43d25a5 Mon Sep 17 00:00:00 2001
From: Nikolai Protasov <nprotaso@amd.com>
Date: Mon, 19 Oct 2026 11:03:15 +0000
Subject: [PATCH] [AMD][Qwen3.8] GDN fused decode proj+conv on HIP and prefill
 opt-ins

Enable the fused decode projection + conv1d path (SGLANG_ENABLE_GDN_DECODE_FUSED_PROJ_CONV)
on HIP, forward prepare_before_cuda_graph_capture from Qwen4Exp, and add
off-by-default HIP opt-ins: SGLANG_GDN_FUSED_QKV_NORM (normalize Q/K in the
prefill QKV prepare kernel), SGLANG_GDN_WIDE_QKV_SPLIT, SGLANG_GDN_PACKED_QWEN4
and SGLANG_GDN_HIP_PREFILL_VIEWS.

From amd-nprotaso/sglang qwen_3_8_improvement: 0c3cedfc32.
---
 .../sglang/kernels/ops/attention/fla/chunk.py | 25 ++++++++++++++++++-
 .../kernels/ops/attention/fla/l2norm.py       | 23 +++++++++++++++--
 .../layers/attention/linear/gdn_backend.py    | 17 +++++++++++--
 python/sglang/srt/models/qwen3_5.py           | 16 +++++++++---
 python/sglang/srt/models/qwen4_exp.py         |  3 +++
 5 files changed, 76 insertions(+), 8 deletions(-)

diff --git a/python/sglang/kernels/ops/attention/fla/chunk.py b/python/sglang/kernels/ops/attention/fla/chunk.py
index f4b892f68b..cc375a9d47 100644
--- a/python/sglang/kernels/ops/attention/fla/chunk.py
+++ b/python/sglang/kernels/ops/attention/fla/chunk.py
@@ -14,13 +14,16 @@ from sglang.kernels.ops.attention.fla.cumsum import chunk_local_cumsum
 from sglang.kernels.ops.attention.fla.index import (
     prepare_chunk_indices,
 )
-from sglang.kernels.ops.attention.fla.l2norm import l2norm_fwd
+from sglang.kernels.ops.attention.fla.l2norm import gdn_prefill_qkv_prepare_fwd, l2norm_fwd
 from sglang.kernels.ops.attention.fla.utils import (
     SUPPRESS_LEVEL,
     autocast_custom_fwd,
     input_guard,
     is_intel,
 )
+from sglang.srt.utils import get_bool_env_var, is_hip
+
+_gdn_fused_qkv_norm = is_hip() and get_bool_env_var("SGLANG_GDN_FUSED_QKV_NORM", "False")
 
 if is_intel:
     from sglang.srt.hardware_backend.xpu.kernels.fla.chunk_delta_h import (
@@ -251,6 +254,26 @@ def chunk_gated_delta_rule(
             )
     if scale is None:
         scale = k.shape[-1] ** -0.5
+    # Normalize while materializing strided inputs, before input_guard copies them.
+    if (
+        _gdn_fused_qkv_norm
+        and use_qk_l2norm_in_kernel
+        and q.ndim == 4
+        and q.shape[0] == 1
+        and k.shape == q.shape
+        and v.ndim == 4
+        and v.shape[0] == 1
+        and v.shape[1] == q.shape[1]
+        and v.shape[-1] == q.shape[-1]
+        and q.shape[-1] == 128
+        and q.dtype == k.dtype == v.dtype == torch.bfloat16
+        and q.shape[1] > 0
+    ):
+        q_p, k_p, v_p = gdn_prefill_qkv_prepare_fwd(
+            q[0], k[0], v[0], normalize_in_prepare=True
+        )
+        q, k, v = q_p.unsqueeze(0), k_p.unsqueeze(0), v_p.unsqueeze(0)
+        use_qk_l2norm_in_kernel = False
     o, h = ChunkGatedDeltaRuleFunction.apply(
         q,
         k,
diff --git a/python/sglang/kernels/ops/attention/fla/l2norm.py b/python/sglang/kernels/ops/attention/fla/l2norm.py
index 30b445d3c1..fa8912e3f2 100644
--- a/python/sglang/kernels/ops/attention/fla/l2norm.py
+++ b/python/sglang/kernels/ops/attention/fla/l2norm.py
@@ -142,6 +142,8 @@ def gdn_prefill_qkv_prepare_kernel(
     D: tl.constexpr,
     BT: tl.constexpr,
     BD: tl.constexpr,
+    EPS: tl.constexpr,
+    NORMALIZE_QK: tl.constexpr,
 ):
     """Materialize strided Q/K/V into token-major tensors in one launch."""
     token_block = tl.program_id(0)
@@ -168,6 +170,9 @@ def gdn_prefill_qkv_prepare_kernel(
         )
         q_values = tl.load(q_block, boundary_check=(0, 1)).to(tl.float32)
         k_values = tl.load(k_block, boundary_check=(0, 1)).to(tl.float32)
+        if NORMALIZE_QK:
+            q_values = q_values / tl.sqrt(tl.sum(q_values * q_values, axis=1) + EPS)[:, None]
+            k_values = k_values / tl.sqrt(tl.sum(k_values * k_values, axis=1) + EPS)[:, None]
         q_output_block = tl.make_block_ptr(
             q_out + head_idx * D,
             (T, D),
@@ -221,8 +226,13 @@ def gdn_prefill_qkv_prepare_fwd(
     k: torch.Tensor,
     v: torch.Tensor,
     eps: float = 1e-6,
+    normalize_in_prepare: bool = False,
 ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
-    """Prepare Q/K/V for FlashInfer, materializing only strided inputs."""
+    """Prepare contiguous Q/K/V, optionally fusing Q/K normalization.
+
+    The default preserves the separate normalization kernels used by FlashInfer.
+    Fused normalization can differ by BF16 rounding from the separate kernels.
+    """
     if q.ndim != 3 or k.shape != q.shape or v.ndim != 3:
         raise ValueError(
             "GDN fused prepare requires equal Q/K [T, Hqk, D] shapes and "
@@ -243,7 +253,12 @@ def gdn_prefill_qkv_prepare_fwd(
     H_V = v.shape[1]
     if D > 512:
         raise ValueError(f"GDN fused prepare supports head dim <= 512, got {D}")
-    if q.is_contiguous() and k.is_contiguous() and v.is_contiguous():
+    if (
+        not normalize_in_prepare
+        and q.is_contiguous()
+        and k.is_contiguous()
+        and v.is_contiguous()
+    ):
         return l2norm_fwd(q, eps), l2norm_fwd(k, eps), v
 
     q_out = torch.empty(q.shape, dtype=q.dtype, device=q.device)
@@ -274,9 +289,13 @@ def gdn_prefill_qkv_prepare_fwd(
         D=D,
         BT=BT,
         BD=BD,
+        EPS=eps,
+        NORMALIZE_QK=normalize_in_prepare,
         num_warps=4,
         num_stages=2,
     )
+    if normalize_in_prepare:
+        return q_out, k_out, v_out
     return l2norm_fwd(q_out, eps), l2norm_fwd(k_out, eps), v_out
 
 
diff --git a/python/sglang/srt/layers/attention/linear/gdn_backend.py b/python/sglang/srt/layers/attention/linear/gdn_backend.py
